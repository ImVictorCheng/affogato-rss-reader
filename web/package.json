{
  "name": "affogato-rss-reader-web",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "prepare:mathjax": "node scripts/prepare-mathjax.mjs",
    "predev": "npm run prepare:mathjax",
    "dev": "vite",
    "prebuild": "npm run prepare:mathjax",
    "build": "tsc -b && vite build",
    "check:ui": "node scripts/check-ui-conventions.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "mathjax": "3.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "nanoid": "3.3.17"
  }
}
